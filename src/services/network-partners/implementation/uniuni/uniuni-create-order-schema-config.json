    },
    {
      "sources": "addresses",
      "destination": "country",
      "transform": "(value) => (value.find(a => a.type === 'DELIVERY') || {}).countryCode || (value.find(a => a.type === 'DELIVERY') || {}).country || ''"
    },
    {
      "sources": "",
      "destination": "address_type",
      "defaultValue": 1,
      "transform": "1"
    },
    {
      "sources": "addresses",
      "destination": "postal_code",
