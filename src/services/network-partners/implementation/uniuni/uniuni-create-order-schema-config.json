    },
    {
      "sources": "addresses",
      "destination": "delivery_address",
      "transform": "(value) => (value.find(a => a.type === 'DELIVERY') || {}).street + ((value.find(a => a.type === 'DELIVERY') || {}).city ? ', ' + (value.find(a => a.type === 'DELIVERY') || {}).city : '')"
    },
    {
      "sources": "addresses",
      "destination": "delivery_unit_no",
      "transform": "(value) => (value.find(a => a.type === 'DELIVERY') || {}).landmark || ''"
    },
    {
      "sources": "",
      "destination": "buzz_code",
      "defaultValue": ""
    },
    {
      "sources": "addresses",
      "destination": "receiver_phone",
      "transform": "(value) => (value.find(a => a.type === 'DELIVERY') || {}).phone || ''"
    },
    {
      "sources": "addresses",
      "destination": "receiver_email",
      "transform": "(value) => (value.find(a => a.type === 'DELIVERY') || {}).email || ''"
    },
    {
      "sources": "parentShipment.dimensions.length",
      "destination": "length",
      "transform": "parseFloat(value) || 0"
    },
    {
      "sources": "parentShipment.dimensions.width",
      "destination": "width",
      "transform": "parseFloat(value) || 0"
    },
    {
      "sources": "parentShipment.dimensions.height",
      "destination": "height",
      "transform": "parseFloat(value) || 0"
    },
    {
      "sources": "",
      "destination": "dimension_uom",
      "defaultValue": "IN",
      "transform": "'IN'"
    },
    {
      "sources": "parentShipment.physicalWeight",
      "destination": "weight",
