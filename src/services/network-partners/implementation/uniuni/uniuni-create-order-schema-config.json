    },
    {
      "sources": "",
      "destination": "weight_uom",
      "defaultValue": "LBS",
      "transform": "'LBS'"
    },
    {
      "sources": "payment.finalAmount",
      "destination": "total_value",
      "transform": "parseFloat(value) || 0"
