      "destination": "currency",
      "transform": "value || 'USD'"
    },
    {
      "sources": "parentShipment.items",
      "destination": "item_description",
      "transform": "(value) => (value && Array.isArray(value)) ? value.map(item => item.description || item.name || '').filter(d => d).join(', ') : ''"
    },
    {
      "sources": "parentShipment.note",
      "destination": "driver_notes",
      "transform": "value || ''"
    },
    {
      "sources": "",
      "destination": "danger_type",
      "defaultValue": ""
    },
    {
      "sources": "",
      "destination": "require_signature",
      "defaultValue": 0,
      "transform": "0"
    },
    {
      "sources": "",
      "destination": "custom_field",
      "defaultValue": null
    }
