    },
    {
      "sources": "",
      "destination": "bag_no",
      "defaultValue": ""
    },
    {
      "sources": "orderId",
      "destination": "internal_account_number",
      "transform": "value || ''"
    },
    {
      "sources": "addresses",
      "destination": "sender",
      "transform": "(value) => (value.find(a => a.type === 'PICKUP') || {}).name || ''"
    },
    {
      "sources": "addresses",
      "destination": "start_phone",
      "transform": "(value) => (value.find(a => a.type === 'PICKUP') || {}).phone || ''"
    },
    {
      "sources": "addresses",
      "destination": "start_postal_code",
      "transform": "(value) => (value.find(a => a.type === 'PICKUP') || {}).zip || ''"
    },
    {
