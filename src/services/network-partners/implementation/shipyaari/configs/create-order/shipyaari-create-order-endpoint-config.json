{
  "name": "Shipyaari Create Order",
  "method": "POST",
  "endpointId": "CREATE_ORDER",
  "partnerCode": "SHIPYAARI",
  "requiresAuth": true,
  "contentType": "application/json",
  "url": "https://api-seller.shipyaari.com/api/v1/order/placeOrderApiV3",
  "partnerId": "SHIPYAARI",
  "headerMapping": [
    {
      "headerName": "Authorization",
      "sourceField": "token",
      "defaultValue": ""
    }
  ],
  "payloadMapperConfig": {
    "fields": [
      {
        "sources": "fmHubAddress",
        "destination": "pickupDetails",
        "isNestedObject": true,
        "nestedMappingConfig": {
          "fields": [
            {
              "sources": ["address1", "address2", "city", "state", "zip"],
              "destination": "fullAddress",
              "transform": "(values) => `${values[0]} ${values[1] ? values[1] + ', ' : ''}${values[2]}, ${values[3]} ${values[4]}`"
            },
            {
              "sources": "zip",
              "destination": "pincode",
              "transform": "parseInt(value) || 0"
            },
            {
              "sources": "",
              "destination": "contact",
              "isNestedObject": true,
              "nestedMappingConfig": {
                "fields": [
                  { "sources": "fmHubAddress.name", "destination": "name" },
                  {
                    "sources": "fmHubAddress.mobile",
                    "destination": "mobileNo",
                    "transform": "parseInt(value) || 0"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "sources": "shippingAddress",
        "destination": "deliveryDetails",
        "isNestedObject": true,
        "nestedMappingConfig": {
          "fields": [
            {
              "sources": ["address1", "address2", "city", "state", "zip"],
              "destination": "fullAddress",
              "transform": "(values) => `${values[0]} ${values[1] ? values[1] + ', ' : ''}${values[2]}, ${values[3]} ${values[4]}`"
            },
            {
              "sources": "zip",
              "destination": "pincode",
              "transform": "parseInt(value) || 0"
            },
            {
              "sources": "",
              "destination": "contact",
              "isNestedObject": true,
              "nestedMappingConfig": {
                "fields": [
                  { "sources": "shippingAddress.name", "destination": "name" },
                  {
                    "sources": "shippingAddress.mobile",
                    "destination": "mobileNo",
                    "transform": "parseInt(value) || 0"
                  }
                ]
              }
            },
            { "sources": "", "destination": "gstNumber", "defaultValue": "" }
          ]
        }
      },
      {
        "sources": "",
        "destination": "boxInfo",
        "isArrayInDestination": true,
        "defaultValue": [
          {
            "name": "box_1",
            "weightUnit": "Kg",
            "deadWeight": 0,
            "length": 0,
            "breadth": 0,
            "height": 0,
            "measureUnit": "cm",
            "products": [
              {
                "name": "Apple Iphone",
                "category": "Electronic",
                "sku": "abc",
                "qty": 2,
                "unitPrice": 100,
                "unitTax": 180,
                "weightUnit": "kg",
                "deadWeight": 1,
                "length": 32,
                "breadth": 32,
                "height": 40,
                "measureUnit": "cm"
              }
            ],
            "codInfo": {
              "isCod": false,
              "collectableAmount": 0,
              "invoiceValue": 2000
            },
            "podInfo": {
              "isPod": false
            },
            "insurance": false
          }
        ],
        "transform": "(value, source) => [{ ...value[0], deadWeight: parseFloat(source.dimensions.weight) || 0, length: parseFloat(source.dimensions.length) || 0, breadth: parseFloat(source.dimensions.breadth) || 0, height: parseFloat(source.dimensions.height) || 0, codInfo: { ...value[0].codInfo, isCod: source.paymentDetails.isCOD || false, collectableAmount: source.paymentDetails.isCOD ? parseFloat(source.paymentDetails.amount) || 0 : 0, invoiceValue: parseFloat(source.paymentDetails.amount) || 0 } }]"
      },
      {
        "sources": "type",
        "destination": "orderType",
        "transform": "(value) => value === 'ECOMM' ? 'B2C' : value"
      },
      {
        "sources": "shippingType",
        "destination": "transit"
      },
      {
        "sources": "partnerCode",
        "destination": "courierPartner"
      },
      {
        "sources": "",
        "destination": "source",
        "defaultValue": ""
      },
      {
        "sources": "orderCreatedDate",
        "destination": "pickupDate",
        "transform": "(value) => value ? new Date(value).getTime().toString() : ''"
      },
      {
        "sources": "",
        "destination": "gstNumber",
        "defaultValue": ""
      },
      {
        "sources": "cAwbNumber",
        "destination": "orderId"
      },
      {
        "sources": "ewayBillNos",
        "destination": "eWayBillNo",
        "transform": "(value) => value && value.length > 0 ? value[0] : ''"
      },
      {
        "sources": "",
        "destination": "brandName",
        "defaultValue": ""
      },
      {
        "sources": "",
        "destination": "brandLogo",
        "defaultValue": "https://upload.wikimedia.org/wikipedia/commons/thumb/2/2f/Google_2015_logo.svg/250px-Google_2015_logo.svg.png"
      }
    ]
  },
  "responseMapping": {
    "successPath": "status",
    "dataPath": "",
    "errorPath": "message"
  }
}
